{
  "name": "vice-and-virtue-desktop",
  "version": "0.1.0",
  "private": true,
  "description": "Vice and Virtue — desktop (Steam) shell around the live web app.",
  "author": "Matthijs Ansinger",
  "main": "main.js",
  "scripts": {
    "start": "electron .",
    "dev": "electron . --dev",
    "dist": "electron-builder",
    "dist:win": "electron-builder --win"
  },
  "devDependencies": {
    "electron": "^33.2.0",
    "electron-builder": "^25.1.8"
  },
  "build": {
    "appId": "io.viceandvirtue.desktop",
    "productName": "Vice and Virtue",
    "directories": {
      "output": "dist",
      "buildResources": "build"
    },
    "files": [
      "main.js",
      "preload.js",
      "error.html"
    ],
    "win": {
      "target": [
        "dir",
        "nsis"
      ],
      "icon": "build/icon.ico"
    },
    "mac": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.icns"
    },
    "linux": {
      "target": [
        "dir"
      ],
      "icon": "build/icon.png"
    }
  }
}
